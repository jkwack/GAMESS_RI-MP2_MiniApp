FC_OFF=mpifort

SDIR=./source/
SRC=${SDIR}/rimp2_energy_whole_KERN.f90

EXE_MKL_OFFLOAD=rimp2-mkl-offload
FFLAGS_MKL_OFFLOAD=-Ofast -i8 -fiopenmp -fopenmp-targets=spir64 -cpp -DMKL_ILP64 -DINTEL -DINTEL_OFFLOAD -DCOMBINED_VERSION -g -qmkl -fsycl
#FFLAGS_MKL_OFFLOAD += -DNOMPI
LDFLAGS_MKL=-lmkl_sycl 

EXES=$(EXE_MKL_OFFLOAD)

all: $(EXES)

$(EXE_MKL_OFFLOAD): $(SRC)
	$(FC_OFF)  $(FFLAGS_MKL_OFFLOAD) $^ -o $@ $(LDFLAGS_MKL)
	rm -rf *.o *.mod *.modmic


.SUFFIXES:
.SUFFIXES: .c .o .f90 .cu .cpp .cuf
.PHONY: clean
clean:
	rm -rf *.o *.mod *.modmic $(EXES)
